{
  "name": "darvis/printserver",
  "description": "Queue print jobs in Laravel and let a print box on location fetch them over HTTPS, so no port has to be open on the router.",
  "keywords": [
    "laravel",
    "printing",
    "cups",
    "ipp",
    "zebra",
    "print-server",
    "laravel-boost"
  ],
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/ArvidDeJong/printserver",
  "authors": [
    {
      "name": "Arvid de Jong",
      "email": "info@arvid.nl"
    }
  ],
  "support": {
    "issues": "https://github.com/ArvidDeJong/printserver/issues",
    "source": "https://github.com/ArvidDeJong/printserver"
  },
  "autoload": {
    "psr-4": {
      "Darvis\\Printserver\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Darvis\\Printserver\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Darvis\\Printserver\\PrintserverServiceProvider"
      ]
    }
  },
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0|^12.0|^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^9.0|^10.0|^11.0",
    "pestphp/pest": "^3.0|^4.0",
    "pestphp/pest-plugin-laravel": "^3.0|^4.0",
    "phpunit/phpunit": "^11.0|^12.0|^13.0"
  },
  "scripts": {
    "test": "pest tests",
    "lint": "pint --test",
    "format": "pint",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
